[global]
monitor = 0
follow = mouse
width = 340
height = 120
offset = 15x42
origin = top-right
scale = 0

font = JetBrainsMono Nerd Font 10
line_height = 2
markup = full
format = "<b>%s</b>\n%b"

alignment = left
vertical_alignment = center

show_age_threshold = 60
word_wrap = yes
ellipsize = middle

idle_threshold = 120
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false

show_indicators = yes
icon_position = left

sticky_history = yes
history_length = 20

browser = firefox
always_run_script = true

# =========================
# Modern Style
# =========================
padding = 14
horizontal_padding = 14
separator_height = 0

frame_width = 2
corner_radius = 14

transparency = 0

# =========================
# Berserk Monochrome Theme
# =========================

[urgency_low]
timeout = 4
background = "#0a0a0acc"
foreground = "#a0a0a0"
frame_color = "#3a3a3a"

[urgency_normal]
timeout = 6
background = "#101010cc"
foreground = "#ffffff"
frame_color = "#d0d0d0"

[urgency_critical]
timeout = 0
background = "#151515dd"
foreground = "#ffffff"
frame_color = "#ffffff"
