[global]
monitor = 0
follow = mouse
width = 340
height = 120
offset = 15x42
origin = top-right
scale = 0

font = JetBrainsMono Nerd Font 10
line_height = 2
markup = full
format = "<b>%s</b>\n%b"

alignment = left
vertical_alignment = center

show_age_threshold = 60
word_wrap = yes
ellipsize = middle

idle_threshold = 120
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false

show_indicators = yes
icon_position = left

sticky_history = yes
history_length = 20

browser = firefox
always_run_script = true

# =========================
# Style
# =========================

padding = 14
horizontal_padding = 14
separator_height = 0

frame_width = 2
corner_radius = 14

transparency = 10

# =========================
# Theme
# =========================

include /home/harsh/.config/themes/current/dunst.conf
