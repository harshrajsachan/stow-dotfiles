/* =====================================================
 * Berserk Monochrome Rofi Theme
 * Black + White + Silver
 * ===================================================== */

* {
    /* ===== Monochrome Palette ===== */

    rosewater: #ffffff;
    flamingo:  #e8e8e8;
    pink:      #d8d8d8;
    mauve:     #c8c8c8;

    red:       #ffffff;
    maroon:    #b8b8b8;
    peach:     #d0d0d0;

    text:      #f5f5f5;
    subtext1:  #d0d0d0;
    subtext0:  #a8a8a8;

    overlay2:  #8a8a8a;
    overlay1:  #6a6a6a;
    overlay0:  #4a4a4a;

    surface2:  #2a2a2a;
    surface1:  #181818;
    surface0:  #101010;

    base:      #050505cc;
    mantle:    #080808cc;
    crust:     #020202cc;

    /* ===== Theme Mapping ===== */

    background:                  transparent;
    background-color:            transparent;

    foreground:                  @text;
    lightfg:                     @text;

    normal-background:           rgba(10,10,10,0.72);
    normal-foreground:           @foreground;

    alternate-normal-background: rgba(16,16,16,0.55);
    alternate-normal-foreground: @foreground;

    selected-normal-background:  rgba(255,255,255,0.18);
    selected-normal-foreground:  #ffffff;

    active-background:           rgba(255,255,255,0.08);
    active-foreground:           #ffffff;

    urgent-background:           rgba(255,255,255,0.12);
    urgent-foreground:           #ffffff;

    selected-active-background:  rgba(255,255,255,0.22);
    selected-active-foreground:  #ffffff;

    selected-urgent-background:  rgba(255,255,255,0.25);
    selected-urgent-foreground:  #ffffff;

    alternate-active-background: @surface0;
    alternate-active-foreground: #ffffff;

    alternate-urgent-background: @surface0;
    alternate-urgent-foreground: #ffffff;

    border-color:                rgba(255,255,255,0.35);
    separatorcolor:              rgba(255,255,255,0.12);

    spacing: 3;
}

/* =====================================================
 * Window
 * ===================================================== */

window {
    transparency: "real";
    location: center;

    width: 520;

    border: 2px;
    border-radius: 16px;
    border-color: @border-color;

    background-color: rgba(5,5,5,0.82);

    padding: 12px;
}

/* =====================================================
 * Main Layout
 * ===================================================== */

mainbox {
    border: 0;
    padding: 0;
    spacing: 8px;
}

/* =====================================================
 * Input Bar
 * ===================================================== */

inputbar {
    background-color: rgba(20,20,20,0.70);

    border: 1px;
    border-radius: 12px;
    border-color: rgba(255,255,255,0.15);

    padding: 8px 12px;
    spacing: 8px;

    children: [
        "prompt",
        "entry"
    ];
}

prompt {
    text-color: #ffffff;
    font: "JetBrainsMono Nerd Font Bold 10";
}

entry {
    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 10";

    placeholder: "Search...";
    placeholder-color: @overlay2;
}

/* =====================================================
 * List View
 * ===================================================== */

listview {
    background-color: transparent;

    border: 0;

    scrollbar: true;
    scrollbar-width: 6px;

    lines: 10;
    columns: 1;

    spacing: 6px;
    cycle: true;
    dynamic: true;

    fixed-height: false;

    padding: 2px;

    mouse-scroll: true;
}

/* =====================================================
 * Elements
 * ===================================================== */

element {
    padding: 8px 10px;
    spacing: 8px;

    border: 0;
    border-radius: 12px;

    background-color: transparent;
    text-color: @foreground;

    cursor: pointer;
}

element normal.normal {
    background-color: rgba(18,18,18,0.45);
    text-color: @foreground;
}

element selected.normal {
    background-color: rgba(255,255,255,0.18);
    text-color: #ffffff;
}

element normal.active {
    background-color: rgba(255,255,255,0.08);
    text-color: #ffffff;
}

element selected.active {
    background-color: rgba(255,255,255,0.22);
    text-color: #ffffff;
}

element normal.urgent {
    background-color: rgba(255,255,255,0.10);
    text-color: #ffffff;
}

element selected.urgent {
    background-color: rgba(255,255,255,0.25);
    text-color: #ffffff;
}

/* =====================================================
 * Text / Icons
 * ===================================================== */

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;

    font: "JetBrainsMono Nerd Font 10";

    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;

    size: 1em;
    cursor: inherit;
}

/* =====================================================
 * Scrollbar
 * ===================================================== */

scrollbar {
    width: 6px;
    border: 0;
    border-radius: 10px;

    background-color: rgba(255,255,255,0.04);

    handle-width: 10px;
    handle-color: rgba(255,255,255,0.65);

    padding: 0;
}

/* =====================================================
 * Message Box
 * ===================================================== */

message {
    border: 0;
    border-radius: 12px;

    background-color: rgba(20,20,20,0.55);

    padding: 10px;
}

textbox {
    text-color: @foreground;
}

/* =====================================================
 * Modes
 * ===================================================== */

configuration {
    modi: "drun,run,window,ssh";
    show-icons: true;

    display-drun: "󰀻 Apps";
    display-run: " Run";
    display-window: " Window";
    display-ssh: "󰣀 SSH";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    drun-display-format: "{icon}  {name}";
    drun-match-fields: "name,generic,exec,categories";

    sorting-method: "normal";
    sort: true;

    drun-use-desktop-cache: true;
    disable-history: false;

    tokenize: true;
    case-sensitive: false;

    auto-select: false;

    window-format: "{w} · {c} · {t}";
}
