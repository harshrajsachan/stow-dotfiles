* {
    background: #1a0f14;
    foreground: #f8d7e3;

    active-background: #2a151f;
    active-foreground: #ffe6ef;

    selected-normal-background: #d98aa6;
    selected-normal-foreground: #1a0f14;

    selected-active-background: #e6a0b8;
    selected-active-foreground: #1a0f14;

    urgent-background: #c75b7a;
    urgent-foreground: #fff0f5;

    selected-urgent-background: #f0a6bd;
    selected-urgent-foreground: #1a0f14;
}
