#!/bin/bash

set -Eeuo pipefail

# ============================================================================
# Ultimate Theme Switcher
# ============================================================================

THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"

YAZI_DIR="$HOME/.config/yazi"
CAVA_DIR="$HOME/.config/cava"
ROFI_DIR="$HOME/.config/rofi"
CACHE_DIR="$HOME/.cache"

ROFI_LAUNCHER="$ROFI_DIR/launch.sh"

# ============================================================================
# Helpers
# ============================================================================

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$@"
    fi
}

die() {
    notify \
        -u critical \
        "Theme Error" \
        "$1"

    echo "Theme Error: $1" >&2
    exit 1
}

# ============================================================================
# Validate
# ============================================================================

[[ -d "$THEMES_DIR" ]] ||
    die "Themes directory does not exist: $THEMES_DIR"

[[ -d "$ROFI_DIR" ]] ||
    die "Rofi directory does not exist: $ROFI_DIR"

[[ -x "$ROFI_LAUNCHER" ]] ||
    die "Rofi launcher does not exist or is not executable: $ROFI_LAUNCHER"

# ============================================================================
# Current Theme
# ============================================================================

CURRENT_THEME=""

if [[ -L "$CURRENT" ]]; then

    CURRENT_THEME="$(basename "$(readlink -f "$CURRENT")")"

fi

# ============================================================================
# Open Theme Launcher
# ============================================================================

SELECTED="$(
    "$ROFI_LAUNCHER" theme
)"

# ============================================================================
# Escape
# ============================================================================

[[ -n "$SELECTED" ]] || exit 0

# ============================================================================
# Clean Selection
# ============================================================================
#
# Handles:
#
#   "catppuccin"
#   "  catppuccin"
#   "catppuccin  "
#   "  catppuccin  "
#   "● catppuccin"
#   CRLF
#
# ============================================================================

# Remove CR
SELECTED="${SELECTED//$'\r'/}"

# Remove old selection marker
SELECTED="${SELECTED#● }"

# Remove leading whitespace
SELECTED="${SELECTED#"${SELECTED%%[![:space:]]*}"}"

# Remove trailing whitespace
SELECTED="${SELECTED%"${SELECTED##*[![:space:]]}"}"

# ============================================================================
# Validate Selection
# ============================================================================

[[ -n "$SELECTED" ]] ||
    exit 0

NEXT_THEME="$SELECTED"
NEXT_DIR="$THEMES_DIR/$NEXT_THEME"

# ============================================================================
# Validate Selected Theme
# ============================================================================

if [[ ! -d "$NEXT_DIR" ]]; then

    die "Theme directory does not exist: $NEXT_DIR"

fi

if [[ ! -r "$NEXT_DIR" ]]; then

    die "Theme directory is not readable: $NEXT_DIR"

fi

# ============================================================================
# Same Theme
# ============================================================================

if [[ "$NEXT_THEME" == "$CURRENT_THEME" ]]; then
    exit 0
fi

# ============================================================================
# Information
# ============================================================================

echo
echo "============================================================"
echo " Theme Switch"
echo "============================================================"
echo " Old : ${CURRENT_THEME:-none}"
echo " New : $NEXT_THEME"
echo " Path: $NEXT_DIR"
echo "============================================================"
echo

# ============================================================================
# 1. Change Global Theme
# ============================================================================

ln -sfnT \
    "$NEXT_DIR" \
    "$CURRENT"

CURRENT_THEME_PATH="$(readlink -f "$CURRENT")"

# ============================================================================
# 2. Rofi Palette
# ============================================================================

ROFI_PALETTE="$CURRENT/rofi.rasi"

if [[ -f "$ROFI_PALETTE" ]]; then

    ln -sfnT \
        "$ROFI_PALETTE" \
        "$ROFI_DIR/rofi.rasi"

else

    echo "Warning: Rofi palette not found:"
    echo "  $ROFI_PALETTE"

fi

# ============================================================================
# 3. CAVA
# ============================================================================

CAVA_CONFIG="$CURRENT/cava.conf"

if [[ -f "$CAVA_CONFIG" ]]; then

    mkdir -p "$CAVA_DIR"

    ln -sfnT \
        "$CAVA_CONFIG" \
        "$CAVA_DIR/config"

    while read -r PID; do

        [[ -n "$PID" ]] || continue

        kill -USR2 "$PID" 2>/dev/null || true

    done < <(pgrep -x cava || true)

fi

# ============================================================================
# 4. Yazi
# ============================================================================

YAZI_CONFIG="$CURRENT/yazi.toml"
YAZI_THEME="$CURRENT/theme.toml"

mkdir -p "$YAZI_DIR"

# --------------------------------------------------------------------------
# yazi.toml
# --------------------------------------------------------------------------

if [[ -f "$YAZI_CONFIG" ]]; then

    ln -sfnT \
        "$YAZI_CONFIG" \
        "$YAZI_DIR/yazi.toml"

fi

# --------------------------------------------------------------------------
# theme.toml
# --------------------------------------------------------------------------

if [[ -f "$YAZI_THEME" ]]; then

    ln -sfnT \
        "$YAZI_THEME" \
        "$YAZI_DIR/theme.toml"

fi

# --------------------------------------------------------------------------
# Live Yazi Theme Reload
# --------------------------------------------------------------------------

if command -v ya >/dev/null 2>&1 &&
    pgrep -x yazi >/dev/null 2>&1 &&
    [[ -f "$YAZI_THEME" ]]; then

    if ! ya emit-to 0 app:theme >/dev/null 2>&1; then
        echo "Warning: failed to hot-reload Yazi theme" >&2
    fi

fi

# ============================================================================
# 5. Wallpaper
# ============================================================================

WALLPAPER_DIR="$CURRENT/wallpapers"
DEFAULT_FILE="$WALLPAPER_DIR/default"

if [[ -f "$DEFAULT_FILE" ]]; then

    DEFAULT_NAME="$(<"$DEFAULT_FILE")"

    # Remove CRLF
    DEFAULT_NAME="${DEFAULT_NAME//$'\r'/}"

    # Remove leading whitespace
    DEFAULT_NAME="${DEFAULT_NAME#"${DEFAULT_NAME%%[![:space:]]*}"}"

    # Remove trailing whitespace
    DEFAULT_NAME="${DEFAULT_NAME%"${DEFAULT_NAME##*[![:space:]]}"}"

    DEFAULT_WALL="$WALLPAPER_DIR/$DEFAULT_NAME"

    if [[ -f "$DEFAULT_WALL" ]]; then

        feh \
            --no-fehbg \
            --bg-fill \
            "$DEFAULT_WALL"

    else

        echo "Warning: wallpaper does not exist:"
        echo "  $DEFAULT_WALL"

    fi

fi

# ============================================================================
# 6. Wallpaper State
# ============================================================================

WALL_STATE="$CACHE_DIR/theme_wall_index"

mkdir -p "$CACHE_DIR"

{
    echo "$CURRENT_THEME_PATH"
    echo "0"
} >"$WALL_STATE"

# ============================================================================
# 7. Dunst
# ============================================================================

if command -v dunstctl >/dev/null 2>&1; then

    dunstctl reload \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 8. Polybar
# ============================================================================

if command -v polybar-msg >/dev/null 2>&1; then

    polybar-msg cmd restart \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 9. i3
# ============================================================================

if command -v i3-msg >/dev/null 2>&1; then

    i3-msg reload \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 10. Kitty
# ============================================================================

if command -v kitten >/dev/null 2>&1 &&
    [[ -f "$CURRENT/kitty.conf" ]]; then

    mapfile -t KITTY_SOCKETS < <(
        find /tmp \
            -maxdepth 1 \
            -type s \
            -name 'kitty-theme.sock-*' \
            2>/dev/null || true
    )

    for KITTY_SOCKET in "${KITTY_SOCKETS[@]}"; do

        kitten @ \
            --to "unix:$KITTY_SOCKET" \
            set-colors \
            --all \
            --configured \
            "$CURRENT/kitty.conf" \
            >/dev/null 2>&1 || true

    done

fi

# ============================================================================
# 11. Current Theme Marker
# ============================================================================

printf '%s\n' "$NEXT_THEME" \
    >"$CACHE_DIR/current-theme"

# ============================================================================
# 12. Success Notification
# ============================================================================

notify \
    -t 2000 \
    "Theme Changed" \
    "Now using $NEXT_THEME"

echo
echo "============================================================"
echo " Theme switched successfully"
echo "============================================================"
echo "  ${CURRENT_THEME:-none} → $NEXT_THEME"
echo "============================================================"
echo
