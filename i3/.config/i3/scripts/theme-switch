#!/bin/bash

set -Eeuo pipefail

# ============================================================================
# Ultimate Theme Switcher
# ============================================================================

THEMES_DIR="$HOME/.config/themes"
CURRENT="$THEMES_DIR/current"

YAZI_DIR="$HOME/.config/yazi"
CAVA_DIR="$HOME/.config/cava"
CACHE_DIR="$HOME/.cache"

# ============================================================================
# Themes
# ============================================================================

THEMES=(
    "berserk"
    "catppuccin"
    "everforest"
    "gruvbox"
    "nord"
    "sakura"
    "twilight"
)

# ============================================================================
# Helpers
# ============================================================================

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$@"
    fi
}

die() {
    notify \
        -u critical \
        "Theme Error" \
        "$1"

    echo "Theme Error: $1" >&2
    exit 1
}

# ============================================================================
# Validate Themes Directory
# ============================================================================

[[ -d "$THEMES_DIR" ]] || \
    die "Themes directory does not exist: $THEMES_DIR"

# ============================================================================
# Current Theme
# ============================================================================

if [[ -L "$CURRENT" ]]; then
    CURRENT_THEME="$(basename "$(readlink -f "$CURRENT")")"
else
    CURRENT_THEME=""
fi

# ============================================================================
# Build Rofi Menu
# ============================================================================

MENU=""

for theme in "${THEMES[@]}"; do
    if [[ "$theme" == "$CURRENT_THEME" ]]; then
        MENU+="● $theme"$'\n'
    else
        MENU+="  $theme"$'\n'
    fi
done

# ============================================================================
# Rofi
# ============================================================================

SELECTED="$(
    printf '%s' "$MENU" |
        rofi \
            -dmenu \
            -i \
            -p "Theme" \
            -no-custom \
            -theme-str '
                window {
                    width: 30%;
                }

                listview {
                    lines: 7;
                }

                element {
                    padding: 8px;
                }
            '
)"

# ============================================================================
# Escape
# ============================================================================

[[ -n "$SELECTED" ]] || exit 0

# ============================================================================
# Clean Selection
# ============================================================================

SELECTED="${SELECTED#● }"
SELECTED="${SELECTED#  }"

NEXT_THEME="$SELECTED"
NEXT_DIR="$THEMES_DIR/$NEXT_THEME"

# ============================================================================
# Validate Selected Theme
# ============================================================================

[[ -d "$NEXT_DIR" ]] || \
    die "Theme directory does not exist: $NEXT_DIR"

[[ -r "$NEXT_DIR" ]] || \
    die "Theme directory is not readable: $NEXT_DIR"

# ============================================================================
# Same Theme
# ============================================================================

if [[ "$NEXT_THEME" == "$CURRENT_THEME" ]]; then
    exit 0
fi

echo
echo "============================================================"
echo " Theme Switch"
echo "============================================================"
echo " Old : ${CURRENT_THEME:-none}"
echo " New : $NEXT_THEME"
echo " Path: $NEXT_DIR"
echo "============================================================"
echo

# ============================================================================
# 1. Change Global Theme
# ============================================================================

ln -sfnT "$NEXT_DIR" "$CURRENT"

CURRENT_THEME_PATH="$(readlink -f "$CURRENT")"

# ============================================================================
# 2. CAVA
# ============================================================================

CAVA_CONFIG="$CURRENT/cava.conf"

if [[ -f "$CAVA_CONFIG" ]]; then

    mkdir -p "$CAVA_DIR"

    ln -sfnT \
        "$CAVA_CONFIG" \
        "$CAVA_DIR/config"

    while read -r PID; do

        [[ -n "$PID" ]] || continue

        kill -USR2 "$PID" 2>/dev/null || true

    done < <(pgrep -x cava || true)

fi

# ============================================================================
# 3. Yazi
# ============================================================================

YAZI_CONFIG="$CURRENT/yazi.toml"
YAZI_THEME="$CURRENT/theme.toml"

mkdir -p "$YAZI_DIR"

# --------------------------------------------------------------------------
# yazi.toml
# --------------------------------------------------------------------------

if [[ -f "$YAZI_CONFIG" ]]; then

    ln -sfnT \
        "$YAZI_CONFIG" \
        "$YAZI_DIR/yazi.toml"

fi

# --------------------------------------------------------------------------
# theme.toml
# --------------------------------------------------------------------------

if [[ -f "$YAZI_THEME" ]]; then

    ln -sfnT \
        "$YAZI_THEME" \
        "$YAZI_DIR/theme.toml"

fi

# --------------------------------------------------------------------------
# Live Yazi Theme Reload
# --------------------------------------------------------------------------

if command -v ya >/dev/null 2>&1 &&
    pgrep -x yazi >/dev/null 2>&1 &&
    [[ -f "$YAZI_THEME" ]]; then

    if ! ya emit-to 0 app:theme >/dev/null 2>&1; then
        echo "Warning: failed to hot-reload Yazi theme" >&2
    fi

fi

# ============================================================================
# 4. Wallpaper
# ============================================================================

WALLPAPER_DIR="$CURRENT/wallpapers"
DEFAULT_FILE="$WALLPAPER_DIR/default"

if [[ -f "$DEFAULT_FILE" ]]; then

    DEFAULT_NAME="$(<"$DEFAULT_FILE")"

    # Remove CRLF
    DEFAULT_NAME="${DEFAULT_NAME//$'\r'/}"

    # Remove leading whitespace
    DEFAULT_NAME="${DEFAULT_NAME#"${DEFAULT_NAME%%[![:space:]]*}"}"

    # Remove trailing whitespace
    DEFAULT_NAME="${DEFAULT_NAME%"${DEFAULT_NAME##*[![:space:]]}"}"

    DEFAULT_WALL="$WALLPAPER_DIR/$DEFAULT_NAME"

    if [[ -f "$DEFAULT_WALL" ]]; then

        feh \
            --no-fehbg \
            --bg-fill \
            "$DEFAULT_WALL"

    fi

fi

# ============================================================================
# 5. Wallpaper State
# ============================================================================

WALL_STATE="$CACHE_DIR/theme_wall_index"

mkdir -p "$CACHE_DIR"

{
    echo "$CURRENT_THEME_PATH"
    echo "0"
} > "$WALL_STATE"

# ============================================================================
# 6. Dunst
# ============================================================================

if command -v dunstctl >/dev/null 2>&1; then

    dunstctl reload \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 7. Polybar
# ============================================================================

if command -v polybar-msg >/dev/null 2>&1; then

    polybar-msg cmd restart \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 8. i3
# ============================================================================

if command -v i3-msg >/dev/null 2>&1; then

    i3-msg reload \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# 9. Kitty
#
# Live color update for all running Kitty instances.
# ============================================================================

if command -v kitten >/dev/null 2>&1 &&
    [[ -f "$CURRENT/kitty.conf" ]]; then

    mapfile -t KITTY_SOCKETS < <(
        find /tmp \
            -maxdepth 1 \
            -type s \
            -name 'kitty-theme.sock-*' \
            2>/dev/null || true
    )

    for KITTY_SOCKET in "${KITTY_SOCKETS[@]}"; do

        kitten @ \
            --to "unix:$KITTY_SOCKET" \
            set-colors \
            --all \
            --configured \
            "$CURRENT/kitty.conf" \
            >/dev/null 2>&1 || true

    done

fi

# ============================================================================
# 10. Optional Theme Configurations
#
# Add mappings for additional applications here.
# ============================================================================

# Example:
#
# if [[ -f "$CURRENT/starship.toml" ]]; then
#     ln -sfnT \
#         "$CURRENT/starship.toml" \
#         "$HOME/.config/starship.toml"
# fi

# ============================================================================
# 11. Current Theme Marker
# ============================================================================

printf '%s\n' "$NEXT_THEME" \
    > "$CACHE_DIR/current-theme"

# ============================================================================
# 12. Success Notification
# ============================================================================

notify \
    -t 2000 \
    "Theme Changed" \
    "Now using $NEXT_THEME"

echo
echo "Theme switched successfully:"
echo "  $CURRENT_THEME → $NEXT_THEME"
echo

